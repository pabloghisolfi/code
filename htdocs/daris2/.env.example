# Copiez ce fichier en « .env » (même dossier) et adaptez les valeurs.
# Le fichier .env n'est jamais servi par Apache (voir .htaccess) et n'est pas versionné.

# production | development
APP_ENV=production
APP_DEBUG=false

# Préfixe d'URL sous lequel le site est servi (dossier dans htdocs). Laisser vide à la racine.
APP_BASE_PATH=/daris2

# Adresse publique absolue, utilisée pour le sitemap, les balises canonical et les e-mails.
# Laisser vide pour la déduire de la requête.
APP_URL=

# Clé secrète (32+ caractères aléatoires) : signatures des liens de commande, hachages.
# Générez-la avec : php -r "echo bin2hex(random_bytes(32));"
APP_SECRET=changez-moi-avec-une-longue-chaine-aleatoire

# Coordonnées de la boutique
SHOP_EMAIL=bonjour@azurine.ch
SHOP_PHONE=+41 21 000 00 00

# E-mails : true pour utiliser mail(), false pour les écrire dans var/mail/ (développement)
MAIL_ENABLED=false
MAIL_FROM=Daris <no-reply@azurine.ch>

# Base SQLite (chemin relatif au dossier var/)
DB_FILE=daris.sqlite

# Paiement carte : clés Stripe (jamais versionnées). Sans STRIPE_SECRET_KEY, les commandes
# carte sont enregistrées avec un message « paiement non configuré » — aucune charge simulée.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
PAYMENT_PROVIDER=none

# Limitation de débit des formulaires : tentatives autorisées par fenêtre (secondes)
RATE_LIMIT_ATTEMPTS=5
RATE_LIMIT_WINDOW=600
