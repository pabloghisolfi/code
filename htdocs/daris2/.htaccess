# ------------------------------------------------------------------
# Daris – boutique : configuration Apache du dossier /daris2/
# Prérequis : mod_rewrite, mod_headers (AllowOverride All sur htdocs).
# ------------------------------------------------------------------

Options -Indexes -MultiViews
ServerSignature Off
AddDefaultCharset UTF-8

# --- Fichiers sensibles jamais servis ---------------------------------
<FilesMatch "^(\.env.*|\.git.*|composer\.(json|lock)|README\.md|router\.php|phpcs\.xml)$">
    Require all denied
</FilesMatch>
<FilesMatch "\.(sqlite|sqlite3|db|log|eml|json|lock|sh|bak)$">
    Require all denied
</FilesMatch>

# --- Réécriture vers le contrôleur frontal ----------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /daris2/

    # Dossiers internes : jamais accessibles par le web (défense en profondeur,
    # chaque dossier contient aussi son propre .htaccess « Require all denied »).
    RewriteRule ^(src|templates|config|var|data|vendor)(/|$) - [F,L]

    # Fichiers et dossiers réels (assets) servis directement.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Tout le reste passe par index.php (routes propres : /daris2/boutique, …)
    RewriteRule ^ index.php [L,QSA]
</IfModule>

# --- En-têtes de sécurité (doublés côté PHP pour les réponses dynamiques) ---
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), interest-cohort=()"
    Header always set Cross-Origin-Opener-Policy "same-origin"
    # HSTS : à activer uniquement lorsque le site est servi en HTTPS (certificat en place).
    # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

    # Cache long pour les assets versionnés (?v=...)
    <FilesMatch "\.(css|js|svg|png|jpg|jpeg|webp|woff2|ico)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

# --- Compression -------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/javascript application/json image/svg+xml
</IfModule>

# --- PHP (si mod_php) ------------------------------------------------
<IfModule mod_php.c>
    php_flag display_errors Off
    php_flag expose_php Off
    php_flag session.cookie_httponly On
    php_flag session.use_strict_mode On
    php_value session.cookie_samesite Lax
</IfModule>
